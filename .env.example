# cp .env.example .env
# Required for M4 (RAGAS eval) and M5 (Enrichment LLM calls)
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optional: đổi model (mặc định gemini-3.5-flash-lite; gemini-3.8-flash free tier chỉ 5 request/phút)
# GEMINI_MODEL=gemini-3.8-flash
# Optional: trần request/phút tự áp (mặc định 12) — tăng lên nếu key có quota trả phí
# GEMINI_RPM=60
